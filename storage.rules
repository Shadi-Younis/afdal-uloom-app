rules_version = '2';

// Recording audio files. Each object belongs to a recordings/{id} document
// (docs/PROJECT_PLAN.md section 3), read here through cross-service rules:
// on deploy, accept granting Storage access to Firestore
// (docs/DEPLOY_NOTES.md). Roles come only from the `role` custom claim.
// Clients never update or delete objects: Cloud Functions clean up.
// Anything not allowed below is denied. After changing this file run
// tool/test_rules.ps1.
service firebase.storage {
  match /b/{bucket}/o {

    // Largest upload, in bytes (100 MiB). Must match
    // AudioFormats.maxUploadBytes in lib/core/constants/audio_formats.dart.
    // Long studio sessions as MP3 can pass 30 MB.
    function maxUploadBytes() {
      return 100 * 1024 * 1024;
    }

    function role() {
      return request.auth.token.get('role', '');
    }

    match /recordings/{studentId}/{fileName} {
      // fileName is `{recordingId}.{ext}`, `{recordingId}.play.mp3` for
      // the centred copy the server makes, or `{recordingId}.student.{ext}`
      // / `{recordingId}.sheikh.{ext}` for the two stems of a two-file
      // recording; Firestore ids contain no dots.
      function recordingId() {
        return fileName.split('\\.')[0];
      }

      function recordingPath() {
        return /databases/(default)/documents/recordings/$(recordingId());
      }

      function recording() {
        return firestore.get(recordingPath()).data;
      }

      // The document points at exactly this object.
      function isRecordingFile() {
        return recording().storagePath == 'recordings/' + studentId + '/' + fileName;
      }

      // A two-file recording: the uploader sends its two stems, and only
      // the server (onRecordingUploaded) writes its storagePath, the stereo
      // file it joins them into.
      function isStems() {
        return recording().get('source', 'stereo') == 'stems';
      }

      // One of the two stems the document names.
      function isStemFile() {
        let path = 'recordings/' + studentId + '/' + fileName;
        return isStems()
          && (recording().stemPaths.student == path || recording().stemPaths.sheikh == path);
      }

      function isPlaybackName() {
        return fileName == recordingId() + '.play.mp3';
      }

      // The centred copy of this student's recording: read with exactly the
      // same rule as the original.
      function isPlaybackFile() {
        return isPlaybackName() && recording().studentId == studentId;
      }

      allow read: if request.auth != null
        && (role() == 'admin'
            || ((isRecordingFile() || isPlaybackFile())
                && ((role() == 'teacher' && recording().teacherId == request.auth.uid)
                    || recording().studentId == request.auth.uid)));

      // The flow (RecordingRepository): create the document, then upload
      // to its storagePath, or its two stemPaths for a two-file recording.
      // Only the uploader of that document may, once each:
      // `resource == null` refuses writing over an existing file (the
      // emulator evaluates such an overwrite as a create, not an update).
      // Only the server (onRecordingUploaded) writes the playback copy and
      // the joined file of a two-file recording.
      allow create: if request.auth != null
        && !isPlaybackName()
        && resource == null
        && firestore.exists(recordingPath())
        && ((isRecordingFile() && !isStems()) || isStemFile())
        && recording().uploadedBy == request.auth.uid
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size > 0
        && request.resource.size < maxUploadBytes();

      allow update, delete: if false;
    }
  }
}
