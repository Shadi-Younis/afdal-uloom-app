rules_version = '2';

// Data model: docs/PROJECT_PLAN.md section 3. Roles come ONLY from the
// `role` custom claim, which only server code sets. Anything not allowed
// below is denied. After changing this file run tool/test_rules.ps1.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is asking --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.get('role', '') == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    // ---- Lookups --------------------------------------------------------

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function halaqaPath(halaqaId) {
      return /databases/$(database)/documents/halaqat/$(halaqaId);
    }

    function isUserWithRole(userId, role) {
      return exists(userPath(userId)) && get(userPath(userId)).data.role == role;
    }

    // ---- Value checks ---------------------------------------------------

    function isStringOfLength(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isIntInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    // A list of at most [max] strings (max <= 10: rules cannot loop, so
    // each position is checked explicitly).
    function isStringList(value, max) {
      return value is list && value.size() <= max
        && isStringOrAbsent(value, 0) && isStringOrAbsent(value, 1)
        && isStringOrAbsent(value, 2) && isStringOrAbsent(value, 3)
        && isStringOrAbsent(value, 4) && isStringOrAbsent(value, 5)
        && isStringOrAbsent(value, 6) && isStringOrAbsent(value, 7)
        && isStringOrAbsent(value, 8) && isStringOrAbsent(value, 9);
    }

    function isStringOrAbsent(list, index) {
      return list.size() <= index || list[index] is string;
    }

    // Only the listed keys changed between the stored and the new document.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- users ----------------------------------------------------------

    match /users/{userId} {
      // A teacher may read a student of a halaqa they teach. In a list
      // query the halaqaId and role filters make this provable.
      function isTeacherOf(user) {
        return isTeacher()
          && user.role == 'student'
          && user.get('halaqaId', null) is string
          && get(halaqaPath(user.halaqaId)).data.teacherId == request.auth.uid;
      }

      allow read: if isSelf(userId) || isAdmin() || isTeacherOf(resource.data);

      // Accounts, roles, halaqa moves and `disabled` are server-side only.
      allow create, delete: if false;

      allow update: if isSelf(userId)
        && onlyChanged(['fcmTokens'])
        && isStringList(request.resource.data.fcmTokens, 10);

      // Memorization progress comes in a later phase.
      match /progress/{surahNumber} {
        allow read, write: if false;
      }
    }

    // ---- halaqat --------------------------------------------------------

    match /halaqat/{halaqaId} {
      // teacherName is a copy of the teacher's fullName for the students,
      // who cannot read teachers' profiles; the server keeps it equal
      // (changeHalaqaTeacher, updateUserProfile).
      function isValidHalaqa(data) {
        return data.keys().hasAll(['name', 'teacherId', 'teacherName'])
          && data.keys().hasOnly(['name', 'teacherId', 'teacherName'])
          && isStringOfLength(data.name, 1, 60)
          && data.teacherId is string
          && isUserWithRole(data.teacherId, 'teacher')
          && data.teacherName == get(userPath(data.teacherId)).data.fullName;
      }

      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent()
            && get(userPath(request.auth.uid)).data.get('halaqaId', null) == halaqaId);

      allow create: if isAdmin() && isValidHalaqa(request.resource.data);

      // Rename only. A new teacher goes through the changeHalaqaTeacher
      // function, which also updates the teacherId copied into recordings.
      allow update: if isAdmin()
        && onlyChanged(['name'])
        && isStringOfLength(request.resource.data.name, 1, 60);

      // Only through the deleteHalaqa function, which first checks that no
      // student or recording still belongs to the halaqa.
      allow delete: if false;
    }

    // ---- recordings -----------------------------------------------------

    match /recordings/{recordingId} {
      // [path] is [base] followed by one of the accepted audio extensions.
      function isAudioPath(path, base) {
        return path in [base + 'mp3', base + 'm4a', base + 'aac',
                        base + 'wav', base + 'ogg', base + 'webm'];
      }

      // `source`: 'stereo' (one file, student left and sheikh right; also
      // when missing) or 'stems' (two files, one per microphone, that the
      // server joins). A stems recording is official; its storagePath is
      // the joined `{id}.mp3`, which only the server writes (storage.rules),
      // and stemPaths names the two files the uploader sends.
      function hasValidSource(data, prefix) {
        return (data.get('source', 'stereo') == 'stereo'
                && !('stemPaths' in data))
          || (data.get('source', 'stereo') == 'stems'
              && data.type == 'official'
              && data.storagePath == prefix + 'mp3'
              && data.stemPaths is map
              && data.stemPaths.keys().hasAll(['student', 'sheikh'])
              && data.stemPaths.keys().hasOnly(['student', 'sheikh'])
              && isAudioPath(data.stemPaths.student, prefix + 'student.')
              && isAudioPath(data.stemPaths.sheikh, prefix + 'sheikh.'));
      }

      // Surah and ayat: none, a surah alone, or a surah with both ayat
      // (absent or null each). The ayat's upper bound depends on the
      // surah, which only the app knows; rules check the order. Optional
      // for official recordings only: a practice says «ماذا ستتلو؟».
      function hasValidAyat(data) {
        let surah = data.get('surahNumber', null);
        let from = data.get('ayahFrom', null);
        let to = data.get('ayahTo', null);
        return (surah == null && from == null && to == null)
          || (isIntInRange(surah, 1, 114)
              && ((from == null && to == null)
                  || (from is int && to is int && from >= 1 && from <= to)));
      }

      function hasAllAyat(data) {
        return data.get('surahNumber', null) != null
          && data.get('ayahFrom', null) != null
          && data.get('ayahTo', null) != null;
      }

      // Checks for every create, whoever the caller: shape, ranges, path,
      // and that studentId / halaqaId / teacherId agree with each other.
      // `analysis` and `playbackPath` are not among the keys: only the
      // server (onRecordingUploaded) writes them.
      function isValidNewRecording(data) {
        let required = ['studentId', 'halaqaId', 'teacherId', 'uploadedBy',
          'type', 'storagePath', 'recordedAt', 'createdAt', 'unreadFeedback',
          'reviewed'];
        let prefix = 'recordings/' + data.studentId + '/' + recordingId + '.';
        let student = get(userPath(data.studentId)).data;
        return data.keys().hasAll(required)
          && data.keys().hasOnly(required.concat(['surahNumber', 'ayahFrom',
                                                  'ayahTo', 'durationSec',
                                                  'source', 'stemPaths']))
          && data.studentId is string
          && data.halaqaId is string
          && data.teacherId is string
          && data.type in ['official', 'practice']
          && hasValidAyat(data)
          && (data.type == 'official' || hasAllAyat(data))
          && (data.get('durationSec', null) == null
              || (data.durationSec is int && data.durationSec >= 0))
          && isAudioPath(data.storagePath, prefix)
          && hasValidSource(data, prefix)
          && data.uploadedBy == request.auth.uid
          && data.recordedAt is timestamp
          && data.createdAt == request.time
          && data.unreadFeedback is bool
          && data.reviewed is bool
          && isUserWithRole(data.studentId, 'student')
          && student.get('halaqaId', null) == data.halaqaId
          && get(halaqaPath(data.halaqaId)).data.teacherId == data.teacherId;
      }

      // An official recording waits for the sheikh to check its voice
      // markers («تمت المراجعة»), so it starts unreviewed.
      function isTeacherUpload(data) {
        return isTeacher()
          && data.teacherId == request.auth.uid
          && data.type == 'official'
          && data.unreadFeedback == false
          && data.reviewed == false;
      }

      function isStudentPractice(data) {
        return isStudent()
          && data.studentId == request.auth.uid
          && data.type == 'practice'
          && data.unreadFeedback == false
          && data.reviewed == false;
      }

      // isTeacher(): a demoted teacher loses access at once.
      function isOwningTeacher() {
        return isTeacher() && resource.data.teacherId == request.auth.uid;
      }

      function isOwningStudent() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      allow read: if isAdmin() || isOwningTeacher() || isOwningStudent();

      allow create: if signedIn()
        && isValidNewRecording(request.resource.data)
        && (isAdmin()
            || isTeacherUpload(request.resource.data)
            || isStudentPractice(request.resource.data));

      allow update: if
        (isOwningStudent()
          && onlyChanged(['unreadFeedback'])
          && request.resource.data.unreadFeedback == false)
        || ((isOwningTeacher() || isAdmin())
          && onlyChanged(['reviewed', 'unreadFeedback'])
          && request.resource.data.reviewed is bool
          && request.resource.data.unreadFeedback is bool)
        // «تعديل السورة والآيات»: an official recording only.
        || ((isOwningTeacher() || isAdmin())
          && resource.data.type == 'official'
          && onlyChanged(['surahNumber', 'ayahFrom', 'ayahTo'])
          && hasValidAyat(request.resource.data));

      // A student may take back a practice recording the sheikh has not
      // reviewed yet; onRecordingDeleted removes its file and notes.
      function isOwnUnreviewedPractice() {
        return isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.type == 'practice'
          && resource.data.reviewed == false;
      }

      allow delete: if isOwningTeacher() || isAdmin() || isOwnUnreviewedPractice();

      // ---- recordings/{id}/feedback -------------------------------------

      match /feedback/{feedbackId} {
        function recording() {
          return get(/databases/$(database)/documents/recordings/$(recordingId)).data;
        }

        // The recording's teacher (also after a halaqa changed teacher:
        // the notes keep their author) and admins manage every note.
        function canManage() {
          return isAdmin() || (isTeacher() && recording().teacherId == request.auth.uid);
        }

        // A written note. Voice markers (kind 'voice') come only from the
        // server, which finds them in the sheikh's channel. No `rating`:
        // the stars were removed (Task 12).
        function isValidNote(data) {
          return data.keys().hasAll(['teacherId', 'note', 'kind', 'createdAt'])
            && data.keys().hasOnly(['teacherId', 'note', 'kind', 'atSecond', 'createdAt'])
            && data.teacherId == request.auth.uid
            && data.kind == 'text'
            && isStringOfLength(data.note, 1, 2000)
            && (data.get('atSecond', null) == null || isIntInRange(data.atSecond, 0, 36000))
            && data.createdAt == request.time;
        }

        // Text only. A voice marker's text may be emptied again; a written
        // note keeps at least one character. A `rating` an old note still
        // has stays untouched, so its text remains editable.
        function isValidEdit(data) {
          return onlyChanged(['note', 'updatedAt'])
            && (isStringOfLength(data.note, 1, 2000)
                || (resource.data.get('kind', 'text') == 'voice'
                    && isStringOfLength(data.note, 0, 2000)))
            && data.updatedAt == request.time;
        }

        allow read: if isAdmin()
          || (isTeacher() && recording().teacherId == request.auth.uid)
          || (signedIn() && recording().studentId == request.auth.uid);

        allow create: if canManage() && isValidNote(request.resource.data);

        allow update: if canManage() && isValidEdit(request.resource.data);

        allow delete: if canManage();
      }
    }
  }
}
